# Copy to .env and fill in. .env is git-ignored — never commit real values.
#
# KEY FORMAT: use Supabase's LEGACY keys — the JSON Web Tokens that start with "eyJ…".
# Dashboard → Project Settings → API → "Legacy anon, service_role API keys" tab.
# The newer sb_publishable_… / sb_secret_… format is NOT used by this project and has
# been observed to be rejected. See docs/OPERATIONS_MANUAL.md §8.4.

# ─── Client-side (compiled into the public JS bundle — must not be secret) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...            # legacy "anon" JWT — public by design
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ─── Netlify Function env vars (set these in the Netlify dashboard, NOT here) ───
# These are read server-side by netlify/functions/*. Never expose them to the client.
# Locally they are only needed by scripts/*.mjs — `npm run dev` does not run functions.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...              # legacy "service_role" JWT — SECRET, full DB access

RESEND_API_KEY=re_...                    # SECRET
RESEND_FROM_EMAIL=Opal Gems <hello@theopalgems.com>

# Inventory app sync — pushes warranty registrants into the inventory "customers" table.
# Leave unset to disable the sync entirely (warranty registration still works).
# The service key is a master key to that database — store it ONLY in Netlify env vars.
INVENTORY_SUPABASE_URL=https://your-inventory-project.supabase.co
INVENTORY_SUPABASE_SERVICE_KEY=eyJ...    # legacy service_role JWT, NOT the sb_secret_ key
INVENTORY_CUSTOMERS_TABLE=customers
